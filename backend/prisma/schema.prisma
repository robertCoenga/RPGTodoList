// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider  = "postgresql"
}
model Player {
  id Int @id @default(autoincrement())
  name String
  username String @unique
  password String
  class RpgClass @relation(fields: [class_id],references: [id])
  class_id Int
  status PlayerStatus?
  buffs Buff[]
  skills Skill[]
  acts Act[]
  inventory Inventory[]
  quests Quest[]
  created_at  DateTime @default(now())
  updated_at  DateTime? @updatedAt
}

model PlayerStatus {
  id Int @id @default(autoincrement())
  energy Int @default(5)
  health Int @default(10)
  focus Int @default(5)
  level Int @default(1)
  xp Int @default(0)
  gold Float @default(0)
  player Player @relation(fields: [player_id], references: [id])
  player_id Int @unique
  created_at  DateTime @default(now())
  updated_at  DateTime? @updatedAt
}

model RpgClass {
  id Int @id @default(autoincrement())
  description String
  type_class RpgTypeClasses[]
  players Player[]
  created_at  DateTime @default(now())
  updated_at  DateTime? @updatedAt

}

model TypeClass{
  id Int @id @default(autoincrement())
  description String
  class RpgTypeClasses[]
  created_at  DateTime @default(now())
  updated_at  DateTime? @updatedAt
}

model RpgTypeClasses {
  class RpgClass @relation(fields: [class_id], references: [id])
  class_id Int
  type TypeClass @relation(fields: [type_id], references: [id])
  type_id Int
  assigned_at DateTime @default(now())
  @@id([class_id, type_id])
}

model Buff {
  id Int @id @default(autoincrement())
  description String
  type String
  player Player @relation(fields: [player_id], references: [id])
  player_id Int
  created_at  DateTime @default(now())
  updated_at  DateTime? @updatedAt
}

model Skill {
  id Int @id @default(autoincrement())
  name String
  description String
  level Int
  parent_id Int?
  parent Skill? @relation("skillParent",fields: [parent_id], references: [id])
  children Skill[] @relation("skillParent")
  player Player @relation(fields: [player_id], references: [id])
  player_id Int
  created_at  DateTime @default(now())
  updated_at  DateTime? @updatedAt

}

model Act {
  id Int @id @default(autoincrement())
  name String
  description String
  deadline DateTime
  xp_reward Int
  gold_reward Int
  status ActStatus @default(NAO_INICIADO)
  player Player @relation(fields: [player_id], references: [id])
  player_id Int
  quests Quest[]
  milestornes ActMilestones[]
  inventory Inventory[]
  created_at  DateTime @default(now())
  updated_at  DateTime? @updatedAt
}

model ActMilestones {
  id Int @id @default(autoincrement())
  description String
  finished Boolean
  deadline DateTime
  reward String
  act_id Int
  act Act @relation(fields: [act_id], references: [id])
  created_at  DateTime @default(now())
  updated_at  DateTime? @updatedAt
}

model Quest {
  id Int @id @default(autoincrement())
  description String
  data_inicio DateTime
  data_fim DateTime
  concluded Boolean
  player Player @relation(fields: [player_id], references: [id])
  player_id Int
  type_id Int
  type QuestType @relation(fields: [type_id], references: [id])
  compelexity Int
  xp_reward Int
  act_id Int?
  act Act? @relation(fields: [act_id], references: [id])
  created_at  DateTime @default(now())
  updated_at  DateTime? @updatedAt
}

model QuestType {
  id Int @id @default(autoincrement())
  description String
  quests Quest[]
  created_at  DateTime @default(now())
  updated_at  DateTime? @updatedAt
}

model Inventory {
  id Int @id @default(autoincrement())
  description String
  value Float
  data DateTime
  status InventoryStatus @default(PLANEJADO)
  act_id Int?
  act Act? @relation(fields: [act_id], references: [id])
  created_at  DateTime @default(now())
  updated_at  DateTime? @updatedAt
  player Player @relation(fields: [player_id], references: [id])
  player_id Int
}

model Installments {
  id Int @id @default(autoincrement())
  qtd_installments Int
  value Float
  deadline DateTime
  paid Boolean
  created_at  DateTime @default(now())
  updated_at  DateTime? @updatedAt
}

model Calendar {
  id Int @id @default(autoincrement())
  data DateTime
  is_feriado Boolean
  created_at  DateTime @default(now())
  updated_at  DateTime? @updatedAt
}

enum ActStatus {
  NAO_INICIADO
  EM_ANDAMENTO
  REMOVIDO
  CONCLUIDO
}

enum InventoryStatus {
  PLANEJADO
  PENDENTE
  REMOVIDO
  PAGO
}